<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="top|center_horizontal">

    <TextView
        android:id="@+id/textPuzzleTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/solve_to_snooze"
        android:textSize="22sp"
        android:textColor="#6750A4"
        android:textStyle="bold"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/textPuzzleSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textPuzzleQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="32sp"
        android:textColor="#000000"
        android:layout_marginTop="48dp" />

    <!-- Input for math/sequence/memory -->
    <LinearLayout
        android:id="@+id/layoutInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp">

        <EditText
            android:id="@+id/editAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textSize="24sp"
            android:gravity="center"
            android:hint="Your answer" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/submit"
            android:textSize="18sp"
            android:padding="14dp" />
    </LinearLayout>

    <!-- Shake counter -->
    <TextView
        android:id="@+id/textShakeCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 / 5"
        android:textSize="48sp"
        android:textColor="#6750A4"
        android:layout_marginTop="32dp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressShake"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:max="5"
        android:visibility="gone" />

</LinearLayout>
