<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TimePicker
            android:id="@+id/timePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:timePickerMode="spinner" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Label" android:textSize="13sp" android:layout_marginTop="12dp" />
        <EditText android:id="@+id/editLabel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text" android:maxLines="1" android:hint="Optional" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/schedule_type" android:textSize="13sp"
            android:layout_marginTop="12dp" />
        <Spinner android:id="@+id/spinnerScheduleType"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <!-- Days of week -->
        <LinearLayout android:id="@+id/layoutDays"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp"
            android:visibility="gone">
            <Button android:id="@+id/btnSun" android:layout_width="0dp"
                android:layout_height="36dp" android:layout_weight="1" android:text="S"
                android:textSize="11sp" android:padding="2dp" />
            <Button android:id="@+id/btnMon" android:layout_width="0dp"
                android:layout_height="36dp" android:layout_weight="1" android:text="M"
                android:textSize="11sp" android:padding="2dp" />
            <Button android:id="@+id/btnTue" android:layout_width="0dp"
                android:layout_height="36dp" android:layout_weight="1" android:text="T"
                android:textSize="11sp" android:padding="2dp" />
            <Button android:id="@+id/btnWed" android:layout_width="0dp"
                android:layout_height="36dp" android:layout_weight="1" android:text="W"
                android:textSize="11sp" android:padding="2dp" />
            <Button android:id="@+id/btnThu" android:layout_width="0dp"
                android:layout_height="36dp" android:layout_weight="1" android:text="T"
                android:textSize="11sp" android:padding="2dp" />
            <Button android:id="@+id/btnFri" android:layout_width="0dp"
                android:layout_height="36dp" android:layout_weight="1" android:text="F"
                android:textSize="11sp" android:padding="2dp" />
            <Button android:id="@+id/btnSat" android:layout_width="0dp"
                android:layout_height="36dp" android:layout_weight="1" android:text="S"
                android:textSize="11sp" android:padding="2dp" />
        </LinearLayout>

        <!-- Months -->
        <LinearLayout android:id="@+id/layoutMonths"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="8dp"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnJan" android:layout_width="0dp"
                    android:layout_height="36dp" android:layout_weight="1" android:text="Jan" android:textSize="10sp" android:padding="2dp" />
                <Button android:id="@+id/btnFeb" android:layout_width="0dp"
                    android:layout_height="36dp" android:layout_weight="1" android:text="Feb" android:textSize="10sp" android:padding="2dp" />
                <Button android:id="@+id/btnMar" android:layout_width="0dp"
                    android:layout_height="36dp" android:layout_weight="1" android:text="Mar" android:textSize="10sp" android:padding="2dp" />
                <Button android:id="@+id/btnApr" android:layout_width="0dp"
                    android:layout_height="36dp" android:layout_weight="1" android:text="Apr" android:textSize="10sp" android:padding="2dp" />
                <Button android:id="@+id/btnMay" android:layout_width="0dp"
                    android:layout_height="36dp" android:layout_weight="1" android:text="May" android:textSize="10sp" android:padding="2dp" />
                <Button android:id="@+id/btnJun" android:layout_width="0dp"
                    android:layout_height="36dp" android:layout_weight="1" android:text="Jun" android:textSize="10sp" android:padding="2dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="4dp">
                <Button android:id="@+id/btnJul" android:layout_width="0dp"
                    android:layout_height="36dp" android:layout_weight="1" android:text="Jul" android:textSize="10sp" android:padding="2dp" />
                <Button android:id="@+id/btnAug" android:layout_width="0dp"
                    android:layout_height="36dp" android:layout_weight="1" android:text="Aug" android:textSize="10sp" android:padding="2dp" />
                <Button android:id="@+id/btnSep" android:layout_width="0dp"
                    android:layout_height="36dp" android:layout_weight="1" android:text="Sep" android:textSize="10sp" android:padding="2dp" />
                <Button android:id="@+id/btnOct" android:layout_width="0dp"
                    android:layout_height="36dp" android:layout_weight="1" android:text="Oct" android:textSize="10sp" android:padding="2dp" />
                <Button android:id="@+id/btnNov" android:layout_width="0dp"
                    android:layout_height="36dp" android:layout_weight="1" android:text="Nov" android:textSize="10sp" android:padding="2dp" />
                <Button android:id="@+id/btnDec" android:layout_width="0dp"
                    android:layout_height="36dp" android:layout_weight="1" android:text="Dec" android:textSize="10sp" android:padding="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Seasons -->
        <LinearLayout android:id="@+id/layoutSeasons"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp"
            android:visibility="gone">
            <Button android:id="@+id/btnSpring" android:layout_width="0dp"
                android:layout_height="36dp" android:layout_weight="1" android:text="Spring" android:textSize="11sp" />
            <Button android:id="@+id/btnSummer" android:layout_width="0dp"
                android:layout_height="36dp" android:layout_weight="1" android:text="Summer" android:textSize="11sp" />
            <Button android:id="@+id/btnAutumn" android:layout_width="0dp"
                android:layout_height="36dp" android:layout_weight="1" android:text="Autumn" android:textSize="11sp" />
            <Button android:id="@+id/btnWinter" android:layout_width="0dp"
                android:layout_height="36dp" android:layout_weight="1" android:text="Winter" android:textSize="11sp" />
        </LinearLayout>

        <!-- Calendar keywords -->
        <LinearLayout android:id="@+id/layoutCalendar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="8dp"
            android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/calendar_keywords_hint" android:textSize="12sp" />
            <EditText android:id="@+id/editCalendarKeywords"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/calendar_keywords" android:inputType="text" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#CCCCCC" android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/puzzle_type" android:textSize="13sp" />
        <Spinner android:id="@+id/spinnerPuzzleType"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/snooze_duration_label" android:textSize="13sp"
            android:layout_marginTop="12dp" />
        <SeekBar android:id="@+id/sliderSnoozeDuration"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="29" android:progress="9" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/max_snoozes_label" android:textSize="13sp" />
        <SeekBar android:id="@+id/sliderMaxSnoozes"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="10" android:progress="3" />

        <CheckBox android:id="@+id/switchVibrate"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/vibrate" android:checked="true"
            android:layout_marginTop="8dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/volume" android:textSize="13sp" android:layout_marginTop="8dp" />
        <SeekBar android:id="@+id/seekbarVolume"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="100" android:progress="80" />

        <Button android:id="@+id/btnSave"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/save" android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>
